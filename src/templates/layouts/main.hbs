<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Keep Clone</title>
    <link rel="icon" href="assets/favicon.ico">
    <script src="https://cdn.tailwindcss.com/3.4.3"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.0/dist/cdn.min.js"></script>
    <style>
        /* Basic scrollbar styling for webkit browsers */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-white dark:bg-gray-800 text-gray-900 dark:text-white">

    <div x-data="{ sidebarOpen: true }" class="flex h-screen">
        <!-- Sidebar -->
        <aside x-show="sidebarOpen"
               x-transition:enter="transition ease-in-out duration-300"
               x-transition:enter-start="-translate-x-full"
               x-transition:enter-end="translate-x-0"
               x-transition:leave="transition ease-in-out duration-300"
               x-transition:leave-start="translate-x-0"
               x-transition:leave-end="-translate-x-full"
               class="fixed inset-y-0 left-0 z-30 w-64 bg-gray-100 dark:bg-gray-900 border-r border-gray-200 dark:border-gray-700 transform lg:relative lg:translate-x-0 lg:block">
            {{> sidebar}}
        </aside>

        <!-- Main content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            {{> header}}

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 dark:bg-gray-800 p-4 md:p-6 lg:p-8">
                <!-- Note Creator Widget Placeholder -->
                <div class="mb-8 max-w-xl mx-auto">
                     {{> note-creator}}
                </div>

                <!-- Notes Grid Placeholder -->
                <div id="notes-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    <!-- Note cards will be rendered here by app.js -->
                    {{{body}}} <!-- This is where index.hbs content will go -->
                </div>
            </main>
        </div>
    </div>

    <!-- Edit Note Modal Placeholder -->
    <div id="edit-note-modal-container">
        {{!-- {{> edit-modal}} --}}
        <!-- Modal will be dynamically rendered here or use a template -->
    </div>

    <script src="js/app.js"></script>
</body>
</html>

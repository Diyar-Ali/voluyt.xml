<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{pageTitle}} - Voluyt</title>
    <meta name="description" content="{{metaDescription}}">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{pageTitle}} - Voluyt">
    <meta property="og:description" content="{{metaDescription}}">
    <meta property="og:image" content="{{ogImage}}">
    <meta property="og:url" content="{{ogUrl}}">
    <meta property="og:type" content="website">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio,line-clamp"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    <!-- GSAP CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'voluyt-teal': '#45B3AF',
                        'voluyt-gold': '#E5A824',
                        'voluyt-orange': '#E88C2C',
                        'voluyt-dark-teal': '#317C79',
                        'voluyt-dark-text': '#212529',
                        'voluyt-subtle-text': '#6c757d',
                        'voluyt-bg-light': '#FFFFFF',
                        'voluyt-bg-subtle': '#F8F9FA',
                        'voluyt-border': '#DEE2E6',
                    },
                    fontFamily: {
                        'heading': ['Montserrat', 'sans-serif'],
                        'body': ['Open Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        body {
            @apply font-body text-voluyt-dark-text bg-voluyt-bg-light;
        }
        h1, h2, h3, h4, h5, h6 {
            @apply font-heading;
        }
        h1 { @apply text-4xl md:text-5xl font-bold leading-tight; } /* desktop: 2.5rem, mobile: 2rem -> Tailwind: text-4xl, text-5xl */
        h2 { @apply text-3xl md:text-4xl font-bold leading-tight; } /* desktop: 2rem, mobile: 1.75rem -> Tailwind: text-3xl, text-4xl */
        h3 { @apply text-2xl md:text-3xl font-semibold leading-snug; } /* desktop: 1.75rem, mobile: 1.5rem -> Tailwind: text-2xl, text-3xl */
        p { @apply text-base leading-relaxed; } /* 1rem, 1.6 leading */
        a {
            @apply text-voluyt-dark-teal font-semibold;
        }
        a:hover {
            @apply underline;
        }
        .btn-primary {
            @apply bg-voluyt-dark-teal text-white py-3 px-6 rounded font-semibold border border-voluyt-dark-teal hover:bg-voluyt-teal hover:border-voluyt-teal;
        }
        .btn-secondary {
            @apply bg-white text-voluyt-dark-teal py-3 px-6 rounded font-semibold border border-voluyt-dark-teal hover:bg-voluyt-dark-teal hover:text-white;
        }
        .card {
            @apply bg-white rounded-lg shadow-lg p-8; /* Tailwind: shadow-lg, p-8 */
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    {{> header}}

    <main class="flex-grow">
        {{{body}}}
    </main>

    {{> footer}}

    <script src="/js/main.js"></script>
</body>
</html>

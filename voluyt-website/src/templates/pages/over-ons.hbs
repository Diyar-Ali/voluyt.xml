{{set "pageTitle" "Over Voluyt - Ons Team en Missie | Consultancy Amsterdam"}}
{{set "metaDescription" "Maak kennis met Voluyt. Leer over onze missie, visie, en het ervaren team van consultants in Amsterdam dat klaarstaat om uw organisatie te transformeren."}}
{{set "keywords" "Over Voluyt, Voluyt team, consultancy team Amsterdam, missie Voluyt, visie Voluyt, organisatieadvies, Pascal Luyten, Menno Henstra, Colin Mols"}}

<section class="py-12 md:py-16 bg-voluyt-gold text-white">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl font-heading font-bold animate-fadeInDown">Over Voluyt</h1>
        <p class="text-lg mt-4 max-w-2xl mx-auto animate-fadeInUp">{{companyProfile.strategyAndBranding.marketPositioning}}</p> {{!-- Using market positioning as subtitle --}}
    </div>
</section>

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center mb-16 md:mb-24">
            <div class="animate-fadeInLeft">
                <h2 class="text-3xl font-heading font-bold text-voluyt-dark-text mb-3">Onze Missie</h2>
                <p class="mb-6 text-voluyt-subtle-text text-lg">{{companyProfile.strategyAndBranding.mission}}</p>
                <h2 class="text-3xl font-heading font-bold text-voluyt-dark-text mb-3 mt-8">Onze Visie</h2>
                <p class="text-voluyt-subtle-text text-lg">{{companyProfile.strategyAndBranding.vision}}</p>
            </div>
            <div class="animate-fadeInRight">
                <img src="/assets/images/placeholder-team-meeting.jpg" alt="Professioneel team van Voluyt consultants" class="rounded-lg shadow-xl aspect-video object-cover">
                <p class="text-sm text-voluyt-subtle-text mt-2 text-center">Voluyt: Samen vooruitgang realiseren.</p>
            </div>
        </div>

        <h2 class="text-3xl font-heading font-bold text-center text-voluyt-dark-text mt-12 mb-12 animate-fadeIn">Ons Kernteam</h2>
        <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {{#each companyProfile.team.keyFigure}}
            <div class="card text-center transform hover:scale-105 transition-transform duration-300 animate-fadeInUp flex flex-col">
                <img src="{{this.photoUrl}}" alt="Foto van {{this.name}}" class="w-32 h-32 rounded-full mx-auto mb-4 border-4 border-voluyt-teal object-cover">
                <h3 class="text-xl font-heading font-semibold text-voluyt-dark-teal">{{this.name}}</h3>
                <p class="text-voluyt-gold font-medium mb-2">{{this.role}}</p>
                <p class="text-sm text-voluyt-subtle-text px-4 flex-grow">{{this.bio}}</p>
            </div>
            {{/each}}
        </div>
    </div>
</section>

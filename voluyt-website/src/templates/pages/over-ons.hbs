{{#partial "body" }}
{{set "pageTitle" "Over Ons"}}
{{set "metaDescription" "Maak kennis met Voluyt, ons team van ervaren consultants, en onze missie om organisaties in Amsterdam en daarbuiten te helpen slagen."}}
{{set "ogUrl" (concat site.baseUrl "/over-ons.html")}}

<section class="py-12 md:py-16 bg-voluyt-gold text-white">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl font-heading font-bold animate-fadeInDown">Over Voluyt</h1>
        <p class="text-lg mt-4 max-w-2xl mx-auto animate-fadeInUp">Wij zijn de consultants die 'het zelf ook gedaan hebben'.</p>
    </div>
</section>

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="animate-fadeInLeft">
                <h2 class="text-3xl font-heading font-bold text-voluyt-dark-text mb-4">Onze Missie</h2>
                <p class="mb-4 text-voluyt-subtle-text">{{companyProfile.strategyAndBranding.mission}}</p>
                <h2 class="text-3xl font-heading font-bold text-voluyt-dark-text mb-4 mt-8">Onze Visie</h2>
                <p class="text-voluyt-subtle-text">{{companyProfile.strategyAndBranding.vision}}</p>
            </div>
            <div class="animate-fadeInRight">
                <img src="/assets/images/placeholder-team-meeting.jpg" alt="Team Voluyt aan het werk" class="rounded-lg shadow-xl">
                {{!-- Replace with a relevant image --}}
            </div>
        </div>

        <h2 class="text-3xl font-heading font-bold text-center text-voluyt-dark-text mt-16 md:mt-24 mb-12 animate-fadeIn">Ons Kernteam</h2>
        <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {{#each companyProfile.team.keyFigure}}
            <div class="card text-center transform hover:scale-105 transition-transform duration-300">
                <img src="{{this.photoUrl}}" alt="{{this.name}}" class="w-32 h-32 rounded-full mx-auto mb-4 border-4 border-voluyt-teal">
                <h3 class="text-xl font-heading font-semibold text-voluyt-dark-teal">{{this.name}}</h3>
                <p class="text-voluyt-gold font-medium mb-2">{{this.role}}</p>
                <p class="text-sm text-voluyt-subtle-text px-4">{{this.bio}}</p>
            </div>
            {{/each}}
        </div>
    </div>
</section>
{{/partial}}
{{> layouts/main}}

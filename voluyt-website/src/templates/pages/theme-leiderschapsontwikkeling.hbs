{{!-- Assuming 'theme' object is passed directly by build.js for this page --}}
{{set "pageTitle" (concat theme.title " - Voluyt Thema")}}
{{set "metaDescription" (concat "Ontdek Voluyt's aanpak en visie op " theme.title ". " theme.shortDescription)}}
{{set "keywords" theme.keywords}}

<section class="py-12 md:py-16 bg-voluyt-orange text-white">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl font-heading font-bold animate-fadeInDown">{{theme.title}}</h1>
        <p class="text-lg mt-4 max-w-2xl mx-auto animate-fadeInUp">{{theme.shortDescription}}</p>
    </div>
</section>

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
            <div class="prose lg:prose-xl max-w-none text-voluyt-subtle-text animate-fadeInUp">
                {{{theme.fullDescription}}}
            </div>

            <div class="mt-12 pt-8 border-t border-voluyt-border text-center">
                <h2 class="text-2xl font-heading font-semibold text-voluyt-dark-text mb-4">Meer weten over {{theme.title}}?</h2>
                <p class="text-voluyt-subtle-text mb-6">Neem contact op voor een gesprek over hoe Voluyt uw organisatie kan helpen met {{theme.title}}.</p>
                <a href="/contact.html" class="btn-primary text-lg">Neem Contact Op</a>
            </div>
        </div>
    </div>
</section>

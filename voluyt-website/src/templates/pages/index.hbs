{{#partial "body" }}
{{set "pageTitle" "Home"}}
{{set "metaDescription" "Voluyt is een consultancybureau in Amsterdam gespecialiseerd in interim management, procesverbetering en business intelligence. Wij helpen organisaties vooruitgang te realiseren."}}
{{set "ogUrl" (concat site.baseUrl "/index.html")}}

<section class="bg-voluyt-bg-subtle py-16 md:py-24 text-center">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-voluyt-dark-text mb-6 animate-fadeInUp">Samen vooruitgang realiseren.</h1>
        <p class="text-lg md:text-xl text-voluyt-subtle-text mb-8 max-w-2xl mx-auto animate-fadeInUp" style="animation-delay: 0.2s;">
            Voluyt helpt organisaties hun volledige potentieel te ontsluiten door complexe uitdagingen om te zetten in concrete, duurzame resultaten.
        </p>
        <a href="/diensten.html" class="btn-primary text-lg animate-fadeInUp" style="animation-delay: 0.4s;">Ontdek onze diensten</a>
    </div>
</section>

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-heading font-bold text-center text-voluyt-dark-text mb-12 animate-fadeIn">Kernactiviteiten</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {{> service-card title="Consultancy" excerpt="Strategisch advies en operationele expertise om uw doelen te bereiken." url="/consultancy.html"}}
            {{> service-card title="Interim Management" excerpt="Tijdelijke invulling van cruciale managementposities met focus op resultaat." url="/interim-management.html"}}
            {{> service-card title="Continuous Improvement" excerpt="Processen optimaliseren en een cultuur van zelfverbeteren creëren." url="/continuous-improvement.html"}}
            {{> service-card title="Business Intelligence" excerpt="Data omzetten in waardevolle inzichten voor betere besluitvorming." url="/business-intelligence.html"}}
            {{> service-card title="Learning & Development" excerpt="Ontwikkelen van vaardigheden en kennis binnen uw organisatie." url="/learning-development.html"}}
        </div>
    </div>
</section>
{{/partial}}
{{> layouts/main}}

<div class="card overflow-hidden">
    {{#if imageUrl}}
    <img src="{{imageUrl}}" alt="{{title}}" class="w-full h-48 object-cover mb-4">
    {{/if}}
    <div class="p-1"> <!-- Adjusted padding as card itself has padding -->
        <h3 class="text-xl font-heading font-semibold text-voluyt-dark-teal mb-2">{{title}}</h3>
        <p class="text-voluyt-subtle-text text-sm mb-4 line-clamp-3">{{summary}}</p>
        <a href="{{url}}" class="btn-primary text-sm">Bekijk Case</a>
    </div>
</div>
